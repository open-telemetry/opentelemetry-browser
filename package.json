{
  "name": "opentelemetry-browser",
  "version": "0.0.0",
  "description": "OpenTelemetry is a distributed tracing and stats collection framework.",
  "keywords": [
    "opentelemetry",
    "observability",
    "browser",
    "web"
  ],
  "homepage": "https://github.com/open-telemetry/opentelemetry-browser",
  "bugs": "https://github.com/open-telemetry/opentelemetry-browser/issues",
  "license": "Apache-2.0",
  "author": "OpenTelemetry Authors",
  "repository": "github:open-telemetry/opentelemetry-browser",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "lefthook install -f",
    "clean": "npx -y rimraf -g \"**/.turbo\" \"**/dist\" \"**/node_modules\"",
    "dev": "turbo run watch dev --filter=sandbox...",
    "example": "turbo run watch dev --filter=examples-all-instrumentations...",
    "build": "turbo run build",
    "check": "npm run check:tsc && npm run check:eslint",
    "check:tsc": "turbo run check-types",
    "check:eslint": "eslint 'packages/**/src/**/*.{*js,*ts}'",
    "check:eslint:dist": "eslint --config eslint.dist.config.js 'packages/**/dist/**/*.js'",
    "lint": "npm run lint:biome && npm run check",
    "lint:biome": "biome check --write",
    "lint:ci": "biome ci && npm run check",
    "validate": "node scripts/validate.js",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "size": "size-limit",
    "test:bundle-size": "node --test scripts/bundle-size-report.test.js"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@size-limit/esbuild": "14.2.0",
    "@size-limit/esbuild-why": "14.2.0",
    "@size-limit/file": "14.2.0",
    "@types/jsdom": "30.0.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-baseline-js": "0.7.5",
    "eslint-plugin-yet-another-license-header": "1.0.0",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "publint": "0.3.25",
    "size-limit": "14.2.0",
    "tsdown": "0.23.2",
    "turbo": "2.11.10",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "workspaces": [
    "e2e-tests",
    "examples/*",
    "packages/*",
    "sandbox"
  ],
  "commitlint": {
    "extends": "@commitlint/config-conventional"
  },
  "packageManager": "npm@12.2.0+sha512.66c2632a94e796649738b2d7894d710c2cc2e1696893823066687f6b0d8a52e5f2b54eeaeaa32ffdc513ecca1e49ff794a5c2ec3f9515d879f1b3182b291cf35",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.16.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24.22.1 || ^26.12.1",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "fsevents": false,
    "lefthook@2.2.1": true
  }
}
